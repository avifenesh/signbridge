# Required — get from https://my.telegram.org
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# Phone number for the relay user account (not a bot token)
TELEGRAM_PHONE=

# Server
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
MAX_SESSIONS=5

# Pyrogram session file name (auth persisted here)
SESSION_FILE=session

# Audio format — phone expects this exact format
SAMPLE_RATE=16000
FRAME_SIZE_MS=20
