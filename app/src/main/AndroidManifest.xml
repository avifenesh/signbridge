<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission - draw on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Audio capture from other apps (API 29+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet - for cloud STT (optional) and model download -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vibrate for call notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keep screen on during calls -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SignBridgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignBridge"
        tools:targetApi="34">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SignBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup Activity (first launch) -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.SignBridge" />

        <!-- Settings Activity -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SignBridge" />

        <!-- Demo Activity — test avatar signing without Telegram -->
        <activity
            android:name=".ui.DemoActivity"
            android:exported="false"
            android:theme="@style/Theme.SignBridge"
            android:screenOrientation="portrait" />

        <!-- Overlay Service - renders avatar on top of Telegram -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Audio Capture Service - captures Telegram audio -->
        <service
            android:name=".audio.AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
